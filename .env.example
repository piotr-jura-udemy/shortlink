# Local SQLite file (optional; defaults to ./sqlite.db)
# SQLITE_PATH=sqlite.db

# Better Auth (required for auth)
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000

# Client IP source for auth rate limits (required in production).
# By default Better Auth trusts a client-supplied X-Forwarded-For, so set the
# header your reverse proxy overwrites, e.g. x-real-ip or cf-connecting-ip...
# BETTER_AUTH_IP_HEADERS=x-real-ip
# ...or the proxies that append to X-Forwarded-For (comma-separated IPs/CIDRs).
# BETTER_AUTH_TRUSTED_PROXIES=10.0.0.0/8
